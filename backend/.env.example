# MongoDB Connection
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DB_NAME=nexus_ai

# OpenAI API Key (Required for text-embedding-3-small vectors & RAG search)
OPENAI_API_KEY=sk-...

# LLM Generation Key (Emergent proxy or OpenAI key)
EMERGENT_LLM_KEY=...
# Or set OPENAI_API_KEY above

# Clerk Authentication (matches your Clerk dashboard)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Models & Upload Limits
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
MAX_UPLOAD_MB=20

# CORS Origins (allow your Vercel frontend and localhost)
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
